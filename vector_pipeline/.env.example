# Set actual bucket/model region explicitly when AWS is ready.
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
DATA_BUCKET=
SILVER_PREFIX=silver
# terraform output rds_master_secret_arn; resolved in memory on each DB connection
RDS_SECRET_ARN=
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# Set only when RDS is ready. Do not commit credentials.
PGHOST=
PGPORT=5432
PGDATABASE=pill
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=/certs/global-bundle.pem
