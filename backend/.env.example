# 약온 백엔드 환경변수 예시 — 복사해서 .env 로 사용하세요. (.env 는 git 에 커밋되지 않습니다)
# AWS(ECS)에서는 비밀값을 Secrets Manager 에서 주입하고, 나머지는 Task Definition 환경변수로 설정합니다.

# ---- 앱 ----
APP_ENV=local                       # local | dev | prod | test
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3321,http://localhost:3000  # 쉼표로 여러 개
FRONTEND_URL=http://localhost:3000

# ---- DB / 캐시 ----
DATABASE_URL=postgresql+asyncpg://yakon:yakon@localhost:5555/yakon
REDIS_URL=redis://localhost:6379/0

# ---- AWS 공통 ----
AWS_REGION=us-east-1
# 로컬 LocalStack 사용 시에만 설정 (AWS 에서는 비워둠)
AWS_ENDPOINT_URL=http://localhost:4566
# 로컬 LocalStack 용 더미 자격증명 (AWS 에서는 Task Role 사용 → 설정하지 않음)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---- S3 업로드 ----
S3_UPLOAD_BUCKET=yakon-local-uploads
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_PRESIGN_EXPIRES_SECONDS=300

# ---- Amazon Bedrock (Claude) ----
BEDROCK_ENABLED=false               # false 면 목업 응답
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
BEDROCK_EFFORT=medium               # low | medium | high | xhigh | max
BEDROCK_MAX_TOKENS=16000

# ---- 처방전 OCR ----
OCR_PROVIDER=mock                   # mock | claude(권장, 한국어 지원) | textract(한국어 미지원)

# ---- 공공데이터포털 ----
DRUG_DATA_SOURCE=mock               # mock | public_api
PUBLIC_DATA_SERVICE_KEY=

# ---- 인증 ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DEMO_LOGIN_ENABLED=true             # 로컬 전용 데모 로그인 (/auth/demo-login)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000/auth/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 서비스 정책 ----
GUEST_DAILY_QUESTION_LIMIT=8
