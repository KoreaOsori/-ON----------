# DB uses database.py + EC2 role + Secrets Manager. No DB environment variables needed.
LLM_V1_REGION=us-east-1
# EC2 instance profile credentials, automatically refreshed by boto3.
# IAM user BedrockAPIKey-wy45 is NOT an EC2 role name or AWS_PROFILE.
LLM_V1_AUTH_MODE=ec2_role
# Local AWS profile/SSO testing only: LLM_V1_AUTH_MODE=default_chain
LLM_V1_SONNET_MODEL_ID=us.anthropic.claude-sonnet-5-5
LLM_V1_HAIKU_MODEL_ID=us.anthropic.claude-haiku-5-5
LLM_V1_DEFAULT_MODEL=haiku
LLM_V1_EMBEDDING_DIMENSIONS=1024
LLM_V1_MAX_OUTPUT_TOKENS=900
LLM_V1_CONTEXT_CHARS=18000
LLM_V1_TOP_K=3
LLM_V1_MAX_DISTANCE=0.65
# Set when exposing beyond localhost. Swagger Authorize accepts this value.
# This protects our HTTP API; it is NOT a Bedrock/AWS API key.
# LLM_V1_API_KEY=replace-with-a-long-random-secret
