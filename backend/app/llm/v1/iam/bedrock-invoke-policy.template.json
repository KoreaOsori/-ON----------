{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ClaudeUSInferenceProfiles",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1:<AWS_ACCOUNT_ID>:inference-profile/us.anthropic.claude-sonnet-5-5",
        "arn:aws:bedrock:us-east-1:<AWS_ACCOUNT_ID>:inference-profile/us.anthropic.claude-haiku-5-5"
      ]
    },
    {
      "Sid": "ClaudeDestinationModels",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-*::foundation-model/anthropic.claude-sonnet-5-5",
        "arn:aws:bedrock:us-*::foundation-model/anthropic.claude-haiku-5-5"
      ]
    },
    {
      "Sid": "TitanQueryEmbeddings",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
    }
  ]
}
