# EC2 배포용 백엔드 환경변수. 복사해서 .env 로 사용 (.env 는 git 에 커밋되지 않음)
# 비밀값은 Secrets Manager 에서 꺼내 채운다:
#   DB 마스터 계정  → terraform output rds_master_secret_arn
#   API 키, JWT 키  → terraform output app_secret_name (pill-check/dev/app)

# ---- 앱 ----
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://<EC2 고정 IP>
FRONTEND_URL=http://<EC2 고정 IP>
RUN_MIGRATIONS=true                 # 시작할 때 alembic upgrade head

# ---- DB (RDS, 스키마 gold / rag 와 같은 데이터베이스) ----
DB_HOST=<terraform output rds_endpoint>
DB_PORT=5432
DB_NAME=pill
DB_USERNAME=
DB_PASSWORD=

# ---- AWS (키는 넣지 않음: EC2 IAM 역할 사용) ----
AWS_REGION=us-east-1

# ---- Amazon Bedrock ----
BEDROCK_ENABLED=false               # 모델 접근 권한 확인 후 true
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8

# ---- 처방전 OCR ----
OCR_PROVIDER=mock                   # mock | claude

# ---- 공공데이터포털 ----
DRUG_DATA_SOURCE=mock               # mock | public_api
PUBLIC_DATA_SERVICE_KEY=            # Secrets Manager 의 E_Drug_API 값

# ---- 인증 ----
JWT_SECRET_KEY=                     # Secrets Manager 의 JWT_SECRET_KEY 값
DEMO_LOGIN_ENABLED=false

# ---- 서비스 정책 ----
GUEST_DAILY_QUESTION_LIMIT=8

# ---- 데이터 파이프라인 (data-pipeline 서비스) ----
E_Drug_API=                         # Secrets Manager 의 E_Drug_API 값 (공공데이터포털)
FOOD_SAFETY_API=                    # Secrets Manager 의 FOOD_SAFETY_API 값 (식품안전나라)
# PIPELINE_DATA_DIR=../../s3        # bronze·silver 를 둘 호스트 폴더 (기본: 저장소의 s3/)
