# 약온 프론트엔드 환경변수 예시 — 복사해서 .env.local 로 사용하세요.
# NEXT_PUBLIC_* 값은 브라우저 번들에 포함되므로 비밀값을 넣지 마세요.

# FastAPI 백엔드 주소
# - 로컬 개발: http://localhost:8000
# - AWS(ALB 경로 라우팅): 비워두면 같은 도메인의 /api/* 로 호출
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 지도 SDK (카카오맵 JavaScript 키 등, 지도 연동 시 사용)
NEXT_PUBLIC_MAP_CLIENT_KEY=
