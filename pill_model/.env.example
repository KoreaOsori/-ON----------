# 복사해서 .env 로 사용 (gitignore). 실제 값은 커밋하지 않는다.

# 백엔드만 아는 공유 토큰 (헤더 X-Worker-Token). 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=

AWS_REGION=us-east-1
# terraform output model_bucket / 팀 데이터 버킷 / 팀 업로드 버킷
MODEL_BUCKET=
DATA_BUCKET=
UPLOAD_BUCKET=

# 배경 제거 모델 (plan.md 3-4 실험 후 확정. bria-rmbg 금지)
REMBG_MODEL=u2netp

# deploy/ocr_models/ 아래 폴더 이름 (compose.yaml 에서 사용)
OCR_MODEL_SET=paddleocr_v5_korean_2026-10-14
