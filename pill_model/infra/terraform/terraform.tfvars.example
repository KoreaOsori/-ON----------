# 복사해서 terraform.tfvars 로 사용 (gitignore). 실제 ID·버킷 이름은 절대 커밋하지 않는다.
# 값은 콘솔의 "백엔드 EC2 인스턴스" 화면 또는 aws ec2 describe-instances 로 확인

vpc_id           = "vpc-xxxxxxxx"
subnet_id        = "subnet-xxxxxxxx" # 백엔드와 같은 VPC의 퍼블릭 서브넷
backend_sg_id    = "sg-xxxxxxxx"     # 백엔드 EC2에 붙은 SG
data_bucket_name = "pill-check-data-123456789012"

# 운영 업로드 버킷 (팀 확인 전에는 빈 값)
upload_bucket_name = ""

# name_prefix   = "pill-worker"
# instance_type = "t3.medium"
